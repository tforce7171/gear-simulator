{
  "name": "gear-simulator",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@11.10.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "lint": "biome check .",
    "format": "biome format --write .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "e2e": "tsx scripts/e2e.ts",
    "verify": "tsx scripts/verify.ts",
    "verify:all": "tsx scripts/verify.ts --all",
    "e2e:install": "playwright install chromium",
    "perf": "tsx scripts/perf.ts"
  },
  "dependencies": {
    "camera-controls": "^3.1.2",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.3",
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.5",
    "@types/pngjs": "^6.0.5",
    "@types/three": "^0.186.0",
    "pngjs": "^7.0.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
